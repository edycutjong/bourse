# ---- CoinMarketCap ----
# MCP key (for the Skill / live signals) — header X-CMC-MCP-API-KEY
CMC_MCP_API_KEY=
# Pro REST key (for historical backtest data) — header X-CMC_PRO_API_KEY
# NOTE: this may be a DIFFERENT key than the MCP one. Get both from pro.coinmarketcap.com
CMC_PRO_API_KEY=

# ---- BSC (ERC-8183 escrow / ERC-8004 identity) — bnbagent SDK env names ----
NETWORK=bsc-testnet
# Encrypts the keystore at ~/.bnbagent/wallets/ (REQUIRED by the SDK)
WALLET_PASSWORD=
# Throwaway BSC-testnet key ONLY — never a key holding real funds.
# Optional: the SDK auto-generates a wallet if absent. (AGENT_PRIVATE_KEY also accepted.)
PRIVATE_KEY=

# ---- ERC-8183 provider config (bnbagent-sdk) ----
ERC8183_AGENT_URL=http://localhost:8003/erc8183
ERC8183_SERVICE_PRICE=1000000000000000000   # 1 token (18 decimals)
# Buyer-side: provider agent wallet (auto-discovered from /erc8183/status if unset)
BOURSE_PROVIDER_ADDRESS=

# ---- Base (CMC x402 / USDC pay-per-request) ----
BASE_RPC=https://mainnet.base.org
BASE_CHAIN_ID=8453
